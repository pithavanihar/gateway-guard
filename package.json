{
  "name": "gateway-guard",
  "version": "1.0.0",
  "description": "Routes Indian payments to a healthy gateway. Razorpay and Cashfree failover that ignores customer failures, tracks health per gateway and method, and retries elsewhere (PhonePe planned for v1.1).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:sandbox": "vitest run --config vitest.sandbox.config.ts",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm run test",
    "docs:tables": "tsx scripts/gen-readme-tables.ts"
  },
  "keywords": [
    "payments",
    "payment-gateway",
    "razorpay",
    "cashfree",
    "india",
    "failover",
    "circuit-breaker",
    "sdk"
  ],
  "author": "Nihar Pithava",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "express": "^5.3.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pithavanihar/gateway-guard.git"
  },
  "homepage": "https://github.com/pithavanihar/gateway-guard#readme",
  "bugs": {
    "url": "https://github.com/pithavanihar/gateway-guard/issues"
  }
}
